{
  "name": "n8n-nodes-hillcountrybots-seo-audit",
  "version": "1.0.1",
  "description": "n8n community node for the Hill Country Bots SEO Audit Tool on Apify. Runs a website SEO audit with your own Apify token and returns page scores, top fixes and an HTML report. About $2 per 1,000 audited pages on Apify; failures are free.",
  "keywords": [
    "apify",
    "apify-actor",
    "hill-country-bots",
    "n8n",
    "n8n-community-node-package",
    "n8n-nodes",
    "seo",
    "seo-audit",
    "website-audit"
  ],
  "license": "MIT",
  "author": {
    "name": "Hill Country Bots",
    "email": "hillcountrybots@proton.me"
  },
  "engines": {
    "node": ">=18.10"
  },
  "packageManager": "npm@10.8.2",
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "merge:api": "npx openapi-merge-cli --config ./openapi.config.json",
    "test": "WEBHOOK_URL=https://localhost:5678 jest --config jest.config.js",
    "create-actor-app": "npx tsx scripts/cli.ts",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist/credentials",
    "dist/nodes",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ApifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ApifySeoAudit/ApifySeoAudit.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "apify-client": "^2.16.0",
    "chalk": "^5.6.0",
    "eslint": "^9.32.0",
    "glob": "^11.0.3",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "nock": "^14.0.5",
    "prettier": "^3.6.2",
    "sharp": "^0.34.2",
    "ts-jest": "^29.3.2",
    "typescript": "5.9.2"
  },
  "homepage": "https://apify.com/hillcountrybots/seo-audit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hillcountrybots/n8n-nodes.git",
    "directory": "n8n-nodes-hillcountrybots-seo-audit"
  }
}
